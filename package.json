    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "fast-glob": "3.3.3",
